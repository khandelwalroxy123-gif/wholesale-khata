rules_version = '2';
// Wholesale Khata – online orders.
// Paste this whole file in Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function shopDoc(s) { return get(/databases/$(database)/documents/shops/$(s)).data; }
    function isOwner(s) { return signedIn() && shopDoc(s).ownerUid == request.auth.uid; }
    function sessPath(s) { return /databases/$(database)/documents/shops/$(s)/sessions/$(request.auth.uid); }
    // A customer may see prices and order only after the shop allowed this visit, and only until it expires.
    function approved(s) {
      return signedIn() && exists(sessPath(s))
        && get(sessPath(s)).data.status == 'approved'
        && request.time < get(sessPath(s)).data.validUntil;
    }
    function approvedTier(s) { return get(sessPath(s)).data.tier; }

    match /shops/{s} {
      // Shop name, phone, UPI ID and open/closed are public so the link page can show them.
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwner(s) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if isOwner(s);

      // Two price lists: retail and wholesale. A customer reads only the one the shop chose for them.
      match /catalog/{tier} {
        allow read: if isOwner(s) || (approved(s) && approvedTier(s) == tier);
        allow write: if isOwner(s);
      }

      // One document per customer device. Normally the customer can only ask (status 'pending')
      // and only the shop owner can allow or decline. If the shop switched on "Allow automatically"
      // for that link (autoRetail / autoWholesale), the customer may approve this one visit
      // themselves, only for the link's own price list and for at most 6 hours.
      function visitOk(d) {
        return d.name is string && d.name.size() > 0 && d.name.size() <= 60
          && d.phone is string && d.phone.size() <= 15
          && d.want in ['retail', 'wholesale']
          && d.visit is string && d.visit.size() <= 20
          && d.requestedAt == request.time;
      }
      function autoOn(s, want) {
        return (want == 'retail' && shopDoc(s).get('autoRetail', false) == true)
          || (want == 'wholesale' && shopDoc(s).get('autoWholesale', false) == true);
      }
      match /sessions/{uid} {
        allow read: if isOwner(s) || (signedIn() && request.auth.uid == uid);
        allow create, update: if isOwner(s) || (
          signedIn() && request.auth.uid == uid && visitOk(request.resource.data) && (
            (request.resource.data.keys().hasOnly(['name', 'phone', 'want', 'status', 'requestedAt', 'visit'])
              && request.resource.data.status == 'pending')
            ||
            (request.resource.data.keys().hasOnly(['name', 'phone', 'want', 'status', 'requestedAt', 'visit', 'tier', 'auto', 'approvedAt', 'validUntil'])
              && request.resource.data.status == 'approved' && request.resource.data.auto == true
              && request.resource.data.tier == request.resource.data.want
              && autoOn(s, request.resource.data.want)
              && request.resource.data.approvedAt == request.time
              && request.resource.data.validUntil is timestamp
              && request.resource.data.validUntil <= request.time + duration.value(6, 'h'))
          ));
        allow delete: if isOwner(s);
      }

      match /orders/{o} {
        allow read: if isOwner(s) || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if approved(s)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'address', 'delivery', 'note', 'tier', 'items',
                                                   'clientTotal', 'total', 'payMode', 'payStatus', 'status', 'createdAt', 'visit'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.tier == approvedTier(s)
          && request.resource.data.status == 'placed'
          && request.resource.data.payStatus == 'unpaid'
          && request.resource.data.payMode in ['cash', 'upi']
          && request.resource.data.delivery in ['delivery', 'pickup']
          && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 150
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.address is string && request.resource.data.address.size() <= 200
          && request.resource.data.note is string && request.resource.data.note.size() <= 200
          && request.resource.data.createdAt == request.time;
        allow update: if isOwner(s) || (
          signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payStatus', 'utr', 'status', 'customerAt'])
          && (
            // customer says "I have paid" by UPI
            (resource.data.payStatus == 'unpaid' && request.resource.data.payStatus == 'claimed'
              && request.resource.data.status == resource.data.status
              && (!('utr' in request.resource.data) || (request.resource.data.utr is string && request.resource.data.utr.size() <= 30)))
            ||
            // customer cancels before the shop accepts
            (resource.data.status == 'placed' && request.resource.data.status == 'cancelled'
              && request.resource.data.payStatus == resource.data.payStatus)
          ));
        allow delete: if isOwner(s);
      }
    }
  }
}
